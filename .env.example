# Blueprint Studio configuration. Copy to .env and fill in, then run: docker compose up
#
# Each model role is one OpenAI-compatible Chat Completions connection, configured by
# a base URL, an API key and a model name (see MODEL-CONNECTION.md). Both models must
# support tool calling and structured output; the agent checks both at startup.
# The API key is sent as a Bearer token and may be left blank for keyless local servers.

# --- Option 1: any OpenAI-compatible endpoint (a vendor, a gateway such as LiteLLM,
#     or a local server such as Ollama at http://host.docker.internal:11434/v1) ---

# Interview role: interviewer, critic, PRD drafting, to-spec, to-tickets.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=<your-api-key>
MODEL_NAME=<model-name>

# Review role (design judge): the security, efficiency and maintainability reviewers
# and the gap merger. Use a different model from the interview role; if both are
# the same, the review still runs and the app warns that the cross-model check is off.
REVIEW_MODEL_BASE_URL=https://api.openai.com/v1
REVIEW_MODEL_API_KEY=<your-api-key>
REVIEW_MODEL_NAME=<another-model-name>

# --- Option 2: Anthropic, through its OpenAI-compatible endpoint (no other setting) ---
# Replace either block above with, for example:
# MODEL_BASE_URL=https://api.anthropic.com/v1/
# MODEL_API_KEY=<your-anthropic-api-key>
# MODEL_NAME=<claude-model-name>
# REVIEW_MODEL_BASE_URL=https://api.anthropic.com/v1/
# REVIEW_MODEL_API_KEY=<your-anthropic-api-key>
# REVIEW_MODEL_NAME=<another-claude-model-name>

# --- Everything else ---

# Postgres used for session state; matches the db service in docker-compose.yml.
DATABASE_URL=postgresql://blueprint:blueprint@db:5432/blueprint
# How the web app's CopilotKit runtime reaches the agent service.
AGENT_URL=http://agent:8000
# Tokens per session across both roles (default 2000000).
SESSION_TOKEN_BUDGET=2000000
# true enables LangSmith tracing through LangChain's standard variables (default false).
LANGSMITH_TRACING=false
# true skips the startup model check, for offline tests only (default false).
SKIP_MODEL_CHECK=false
# Agent bind address and port (defaults 0.0.0.0 and 8000).
HOST=0.0.0.0
PORT=8000
